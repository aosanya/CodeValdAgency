# syntax=docker/dockerfile:1
#
# Build context MUST be the monorepo root so the COPY lines can reach
# CodeValdSharedLib/ — go.mod has a replace directive for it, which only
# resolves when it is present on disk at build time.
#
# Invoked as:
#   docker build -f CodeValdAgency/Dockerfile.server -t codevaldagency:local ../..

# ── Build stage ───────────────────────────────────────────────────────────────
FROM golang:1.25-alpine AS build

WORKDIR /src

# Local replace dependency — referenced via `replace` in CodeValdAgency/go.mod.
COPY CodeValdSharedLib/ /CodeValdSharedLib/

# Cache dependency downloads separately from source changes.
COPY CodeValdAgency/go.mod CodeValdAgency/go.sum ./
RUN go mod download

# Copy the rest of the source and build the server binary.
COPY CodeValdAgency/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /codevaldagency-server ./cmd

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM gcr.io/distroless/static-debian12

COPY --from=build /codevaldagency-server /codevaldagency-server

# gRPC port (CODEVALDAGENCY_GRPC_PORT)
EXPOSE 50056

ENTRYPOINT ["/codevaldagency-server"]
